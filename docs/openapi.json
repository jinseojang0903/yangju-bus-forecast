  "info": {
    "description": "계약: docs/api-contract.md (v2). 모든 4xx/5xx 는 {\"error\": {\"code\", \"message\", \"details\"}} 형식이다. FastAPI 기본 422 는 400 VALIDATION_FAILED 로 바꿔 응답한다.",
    "title": "탈 수 있을까? 양주 광역버스 만차 예보 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "수집기 상태 파일만 읽는다. GBIS 를 부르지 않는다.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "RATE_LIMITED: 호출 횟수 제한 초과(Retry-After 헤더, 초)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "INTERNAL_ERROR: 서버 내부 오류"
          }
        },
        "summary": "수집 상태(공개 최소)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/parse-query": {
      "post": {
        "description": "text 는 앞뒤 공백을 뺀 1–200자. 빈 문자열·초과면 400. 원문은 저장·로그하지 않는다.",
        "operationId": "parse_query_api_v1_parse_query_post",
        "requestBody": {
          "content": {
