# backend/.env 의 예시. 이 파일을 backend/.env 로 복사한 뒤 값을 채운다. 값은 커밋하지 않는다.

# 공공데이터포털 GBIS 서비스 키. 마이페이지의 "일반 인증키(Decoding)" 값을 그대로 넣는다.
# (Encoding 값을 넣어도 수집기가 한 번 디코딩해서 쓰지만, Decoding 값을 권장한다.)
GBIS_SERVICE_KEY=

# Supabase PostgreSQL 접속 문자열. 비워 두면 DB 저장을 건너뛰고 JSONL 파일에만 저장한다.
# 예: postgresql://postgres.<프로젝트>:<비밀번호>@<호스트>:5432/postgres
DATABASE_URL=

# LLM API 키 (F08 에서 사용 예정). 지금은 비워 둔다.
LLM_API_KEY=

# 수집 원본(JSONL)·상태 파일을 둘 폴더. 비워 두면 저장소 루트의 data/collected 를 쓴다.
COLLECT_DATA_DIR=
