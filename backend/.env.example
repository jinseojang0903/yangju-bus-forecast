# backend/.env 의 예시. 이 파일을 backend/.env 로 복사한 뒤 값을 채운다. 값은 커밋하지 않는다.

# 공공데이터포털 GBIS 서비스 키. 마이페이지의 "일반 인증키(Decoding)" 값을 그대로 넣는다.
# (Encoding 값을 넣어도 수집기가 한 번 디코딩해서 쓰지만, Decoding 값을 권장한다.)
GBIS_SERVICE_KEY=

# Supabase PostgreSQL 접속 문자열. 비워 두면 DB 저장을 건너뛰고 JSONL 파일에만 저장한다.
# 예: postgresql://postgres.<프로젝트>:<비밀번호>@<호스트>:5432/postgres
DATABASE_URL=
# 선택. Supabase DB 서버 CA 인증서 파일 경로(대시보드 Project Settings > Database > SSL Configuration 에서 내려받음).
# 넣으면 적재 스크립트가 sslmode=verify-full 로 서버를 확인한다. 비워 두면 sslmode=require(암호화만).
DATABASE_SSLROOTCERT=

# LLM API 키 (F08 에서 사용 예정). 지금은 비워 둔다.
LLM_API_KEY=

# 수집 원본(JSONL)·상태 파일을 둘 폴더. 비워 두면 저장소 루트의 data/collected 를 쓴다.
COLLECT_DATA_DIR=

# --- 예보 API ---
# GET /api/v1/health/detail 의 X-Health-Token 헤더와 비교할 값. 비워 두거나 32자 미만이면 상세는 항상 404.
# 만드는 법: python -c "import secrets;print(secrets.token_urlsafe(32))"  (팀 안에서만 공유한다)
HEALTH_DETAIL_TOKEN=

# true 면 가짜 저장소와 /snapshot 의 scenario 쿼리를 쓴다(계약 12장). DB 저장소가 생기기 전까지 true.
FAKE_DATA=true

# CORS 허용 출처(쉼표 구분, 예: https://example.org). 비워 두면 어떤 출처도 허용하지 않는다.
# 개발 중에는 Vite 프록시로 같은 출처에서 부르므로 localhost 를 넣지 않는다.
CORS_ALLOW_ORIGINS=
